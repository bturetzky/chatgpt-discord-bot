{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "poetry"
  ],
  "schedule": [
    "* 6-10 * * 1"
  ],
  "timezone": "America/Los_Angeles",
  "automerge": false,
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 6-10 * * 1"
    ]
  }
}
